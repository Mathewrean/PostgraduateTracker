# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database
# Leave DATABASE_URL unset for local dev; Django falls back to db_build.sqlite3.

# Email Configuration - Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@gmail.com

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_ENABLED=false

# JWT Settings
JWT_SECRET_KEY=jwt-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256

# Application Settings
MAX_FILE_SIZE=10485760
THESIS_WAITING_PERIOD_DAYS=90
COMPLAINT_RESPONSE_DEADLINE_DAYS=14

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
